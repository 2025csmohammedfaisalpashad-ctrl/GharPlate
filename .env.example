# GharPlate Environment Configuration (.env.example)
# Copy this file to .env and adjust values as needed. Never commit real secrets to Git.

# Application Settings
APP_NAME=GharPlate
APP_ENV=development
APP_VERSION=1.0.0
API_V1_STR=/api/v1
DEBUG=false

# Database Configuration (SQLite default; PostgreSQL compatible e.g. postgresql+psycopg://user:pass@db:5432/gharplate)
DATABASE_URL=sqlite:///./gharplate.db

# CORS & Security
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8080
MAX_UPLOAD_SIZE_BYTES=5242880
ALLOWED_IMAGE_MIMES=image/jpeg,image/png,image/webp

# External API Integrations (Optional — offline/manual fallbacks are enabled automatically)
OPEN_FOOD_FACTS_API_URL=https://world.openfoodfacts.org/api/v2/product
OPEN_FOOD_FACTS_USER_AGENT=GharPlate/1.0 (https://github.com/gharplate/gharplate; educational-nutrition-platform)
ENABLE_EXTERNAL_BARCODE_LOOKUP=true

# Optional Vision / AI Provider (Not required for core functionality; never used as sole clinical authority)
VISION_PROVIDER=heuristic_local
GEMINI_API_KEY=

# Frontend Build Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
