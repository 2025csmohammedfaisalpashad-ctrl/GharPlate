# GharPlate Environment Configuration (.env.example)
# Copy this file to .env and adjust values as needed. Never commit real secrets to Git.

# Application Settings
APP_NAME=GharPlate
APP_ENV=development
APP_VERSION=2.0.0
API_V1_STR=/api/v1
DEBUG=false

# Database Configuration (SQLite default resolves to backend/gharplate.db; PostgreSQL compatible)
DATABASE_URL=sqlite:///./gharplate.db

# Authentication, Server-Side Sessions & Cookie Security
SESSION_COOKIE_NAME=gharplate_session
CSRF_COOKIE_NAME=gharplate_csrf
SESSION_EXPIRE_HOURS=24
SESSION_REMEMBER_ME_DAYS=30
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# CORS & Upload Security
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8080
MAX_UPLOAD_SIZE_BYTES=5242880
ALLOWED_IMAGE_MIMES=image/jpeg,image/png,image/webp

# Ollama Local AI Assistant
# On macOS host: http://127.0.0.1:11434
# Inside Docker container on macOS: http://host.docker.internal:11434
ENABLE_LOCAL_AI_ASSISTANT=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=120

# Open Food Facts (API v3 primary for product lookup, v2 adapter for search)
ENABLE_EXTERNAL_BARCODE_LOOKUP=true
OPEN_FOOD_FACTS_API_V3_URL=https://world.openfoodfacts.org/api/v3/product
OPEN_FOOD_FACTS_API_URL=https://world.openfoodfacts.org/api/v2/product
OPEN_FOOD_FACTS_SEARCH_URL=https://world.openfoodfacts.org/cgi/search.pl
OPEN_FOOD_FACTS_USER_AGENT=GharPlate/2.0 (https://github.com/gharplate/gharplate; educational-nutrition-platform)
OPEN_FOOD_FACTS_CACHE_HOURS=168

# USDA FoodData Central (Optional supplemental nutrition provider; get a free key at https://fdc.nal.usda.gov/api-key-signup.html)
ENABLE_FOODDATA_CENTRAL=true
FDC_API_KEY=

# External Web Search (Optional — supports "brave" or "tavily")
ENABLE_EXTERNAL_WEB_SEARCH=false
WEB_SEARCH_PROVIDER=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Data Caching
ENABLE_PRODUCT_CACHE=true
PRODUCT_CACHE_HOURS=168

# Optional Vision / AI Provider
VISION_PROVIDER=heuristic_local
GEMINI_API_KEY=

# Frontend Build Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
