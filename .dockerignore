# Git & CI metadata
.git
.gitignore
.github

# Local environment secrets (never bake into images)
.env
.env.*
!.env.example

# Python caches, virtualenvs & local SQLite databases
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.venv/
**/venv/
**/*.db
**/*.sqlite
**/*.sqlite3
data/db/*.db

# Node modules & build outputs
frontend/node_modules/
frontend/dist/
frontend/coverage/
**/*.log

# OS metadata
.DS_Store
Thumbs.db
